# --- Authentication ---------------------------------------------------------
# Auth is chosen automatically: interactive browser sign-in unless a secret or a
# static token is present. Override explicitly with OUTLOOK_AUTH if you want.
#   OUTLOOK_AUTH=interactive | client-credentials | token

# Entra (Azure AD) app (client) id. For interactive browser sign-in, register a
# PUBLIC client application with the redirect URI http://localhost.
OUTLOOK_CLIENT_ID=
# Directory tenant: a tenant id, or common | organizations | consumers (default common).
OUTLOOK_TENANT_ID=common

# --- App-only (automation) --------------------------------------------------
# Set a client secret to use client-credentials (app-only) auth instead of a browser.
# App-only tokens have no signed-in user, so OUTLOOK_USER is required.
OUTLOOK_CLIENT_SECRET=
OUTLOOK_USER=

# --- Static token (alternative) ---------------------------------------------
# A pre-obtained Microsoft Graph bearer token. Simplest, but you manage its lifetime.
OUTLOOK_TOKEN=

# --- Interactive login tuning (optional) ------------------------------------
# Delegated scopes requested at sign-in (comma-separated). Defaults cover mail read/send.
OUTLOOK_SCOPES=offline_access,User.Read,Mail.Read,Mail.ReadWrite,Mail.Send,MailboxSettings.Read,Files.ReadWrite
# Where the cached access/refresh token is stored. Default: ~/.mcp-outlook/token.json
OUTLOOK_TOKEN_CACHE=
# Fixed loopback port for the sign-in redirect, or 0 to pick a free one.
OUTLOOK_REDIRECT_PORT=0

# --- Connection -------------------------------------------------------------
# Microsoft Graph base URL and OAuth authority (rarely changed; e.g. sovereign clouds).
OUTLOOK_GRAPH_BASE=https://graph.microsoft.com/v1.0
OUTLOOK_AUTHORITY=https://login.microsoftonline.com
# Request timeout in milliseconds.
OUTLOOK_TIMEOUT_MS=30000
# Max messages/contacts returned per list/search (1-200).
OUTLOOK_MAX_RESULTS=25

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
#   read-only  -> read tools (whoami, list_folders, list_messages, search_messages,
#                 get_message, list_attachments, list_contacts)
#   read-write -> adds create_draft, send_mail, reply_mail, forward_mail, mark_read, move_message
#   admin      -> adds delete_message (needs OUTLOOK_ALLOW_DELETE=true)
OUTLOOK_MODE=read-only
# Sending mail (send/reply/forward) requires this in addition to read-write mode.
OUTLOOK_ALLOW_SEND=false
# Comma-separated folder allowlist (id or well-known name). Empty = all. Writes/moves only.
OUTLOOK_FOLDER_ALLOWLIST=
# Folders that can be read but never written to, e.g. sentitems,archive.
OUTLOOK_PROTECTED_FOLDERS=
# Destructive ops (delete_message) require this in addition to admin mode.
OUTLOOK_ALLOW_DELETE=false
# Validate + log writes without executing them.
OUTLOOK_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
OUTLOOK_AUDIT_LOG=true
